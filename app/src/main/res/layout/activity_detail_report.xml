<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detail Ancaman"
            android:textColor="@color/text_main"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/ivDetailProof"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ketuk gambar untuk memperbesar"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="12dp"
            android:textStyle="italic"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:padding="20dp"
                android:stretchColumns="1">

                <TableRow android:paddingVertical="8dp">

                    <TextView
                        android:text="📅 Waktu:"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvValTime"
                        android:gravity="end"
                        android:textColor="@color/text_main"
                        android:textStyle="bold" />
                </TableRow>

                <TableRow android:paddingVertical="8dp">

                    <TextView
                        android:text="👥 Jumlah Wajah:"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvValFaces"
                        android:gravity="end"
                        android:textColor="@color/text_main"
                        android:textStyle="bold" />
                </TableRow>


                <TableRow android:paddingVertical="8dp">

                    <TextView
                        android:text="💡 Intensitas Cahaya:"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvValLight"
                        android:gravity="end"
                        android:textColor="@color/text_main"
                        android:textStyle="bold" />
                </TableRow>

                <TableRow android:paddingVertical="8dp">

                    <TextView
                        android:text="⚡ Respons Sistem:"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvValResp"
                        android:gravity="end"
                        android:textColor="@color/text_main"
                        android:textStyle="bold" />
                </TableRow>
                <TableRow android:paddingVertical="8dp">

                    <TextView
                        android:text="📷 FPS Rata-rata:"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvValfps"
                        android:gravity="end"
                        android:textColor="@color/text_main"
                        android:textStyle="bold" />
                </TableRow>

            </TableLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>